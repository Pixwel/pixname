# Pixname service environment. Copy to .env.local for `npm run dev`; on Vercel set these in
# Project → Settings → Environment Variables. Everything is optional for local development.

# --- Database (Turso) ---------------------------------------------------------
# Set automatically when the Turso integration is connected to the Vercel project.
# Leave unset locally to use ./pixname-local.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- AI matching: pick ONE way to reach the model ------------------------------
# A) Anthropic directly: set your key and the service calls the Anthropic API with it.
ANTHROPIC_API_KEY=
# B) Vercel AI Gateway (used when ANTHROPIC_API_KEY is empty). On Vercel it authenticates
#    itself, so nothing is needed there; for local dev create a key in Vercel → AI Gateway.
AI_GATEWAY_API_KEY=

# Model; either form works ("claude-sonnet-5-5" or "anthropic/claude-sonnet-5.5").
# Default: claude-sonnet-5-5 (fast, inexpensive). claude-opus-5-5 for the most accurate,
# claude-haiku-5-5 for the cheapest.
PIXNAME_MODEL=

# Set to "off" to disable AI matching (the app then only uses its own matcher).
PIXNAME_AI=
