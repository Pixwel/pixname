{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixname",
  "version": "0.2.7",
  "identifier": "com.pixwel.pixname",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pixname",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Pixwel",
    "category": "Utility",
    "shortDescription": "Rename media to the Pixwel ingest filename standard",
    "copyright": "\u00a9 Pixwel",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0OTg4MjVDOEQxQjE5QTUKUldTbEdSdU5YSUtZRkJZQVdDaW9rN3Z0Zy9YYldiWnJBVitITHVSYStHZHVmVHIwbFpwYm5pbUMK",
      "endpoints": [
        "https://github.com/Pixwel/pixname/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
