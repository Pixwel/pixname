# Pixname app build settings. Copy to .env.local (git-ignored) for `npm run tauri dev`.
# Release builds take these from GitHub Actions variables instead (see .github/workflows/release.yml).

# The Pixname service (service/ in this repo): shared vendor codes, team memory and AI matching.
# Used unless someone sets another address in Settings → Advanced. Leave empty to work without it.
# Local: run `cd service && npm run dev`, then use http://localhost:3000
VITE_PIXNAME_SERVICE_URL=
